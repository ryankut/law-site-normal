generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String?
  firstName     String
  lastName      String
  phone         String?
  role          Role     @default(CLIENT)
  avatar        String?
  isActive      Boolean  @default(true)
  clerkId       String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clientProfile ClientProfile?
  adminProfile  AdminProfile?
  appointments  Appointment[]
  messages      Message[]
  documents     Document[]
  payments      Payment[]
  notifications Notification[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model ClientProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address           String?
  city              String?
  state             String?
  zipCode           String?
  dateOfBirth       DateTime?
  emergencyContact  String?
  emergencyPhone    String?
  referralSource    String?
  caseType          String?
  notes             String?
  intakeFormData    Json?

  @@map("client_profiles")
}

model AdminProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String?
  bio             String?
  education       String[]
  barAdmissions   String[]
  certifications  String[]
  awards          String[]
  yearsExperience Int?
  specialties     String[]

  @@map("admin_profiles")
}

model Appointment {
  id                  String            @id @default(uuid())
  clientId            String
  client              User              @relation(fields: [clientId], references: [id])
  date                DateTime
  duration            Int               @default(60)
  type                AppointmentType
  status              AppointmentStatus @default(PENDING)
  meetingLink         String?
  notes               String?
  intakeCompleted     Boolean           @default(false)
  depositPaid         Boolean           @default(false)
  depositAmount       Decimal?          @db.Decimal(10, 2)
  matterTypeId        String?
  matterType          MatterType?       @relation(fields: [matterTypeId], references: [id], onDelete: SetNull)
  preferredAttorneyId String?
  preferredAttorney   TeamMember?       @relation(fields: [preferredAttorneyId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@map("appointments")
}

model Case {
  id            String     @id @default(uuid())
  caseNumber    String     @unique
  clientId      String
  title         String
  description   String?
  practiceArea  String
  status        CaseStatus @default(ACTIVE)
  value         Decimal?   @db.Decimal(12, 2)
  outcome       String?
  startDate     DateTime   @default(now())
  endDate       DateTime?
  isFeatured    Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  documents     Document[]
  notes         CaseNote[]

  @@map("cases")
}

model CaseNote {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  content   String
  isPrivate Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())

  @@map("case_notes")
}

model PracticeArea {
  id          String         @id @default(uuid())
  parentId    String?
  parent      PracticeArea?  @relation("PracticeAreaHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    PracticeArea[] @relation("PracticeAreaHierarchy")
  name        String
  slug        String         @unique
  iconUrl     String?
  imageUrl    String?
  shortDesc   String?
  body        String?        @db.Text
  metaTitle   String?
  metaDesc    String?
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  matterTypes  MatterType[]
  faqs         Faq[]
  teamMembers  TeamPracticeArea[]

  @@map("practice_areas")
}

model MatterType {
  id             String        @id @default(uuid())
  name           String
  practiceAreaId String?
  practiceArea   PracticeArea? @relation(fields: [practiceAreaId], references: [id], onDelete: SetNull)
  sortOrder      Int           @default(0)
  isActive       Boolean       @default(true)

  appointments   Appointment[]

  @@map("matter_types")
}

model TeamMember {
  id          String   @id @default(uuid())
  fullName    String
  roleTitle   String
  photoUrl    String?
  bio         String?  @db.Text
  email       String?
  linkedinUrl String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  practiceAreas TeamPracticeArea[]
  newsArticles  NewsArticle[]
  appointments  Appointment[]

  @@map("team_members")
}

model TeamPracticeArea {
  teamMemberId   String
  teamMember     TeamMember   @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  practiceAreaId String
  practiceArea   PracticeArea @relation(fields: [practiceAreaId], references: [id], onDelete: Cascade)

  @@id([teamMemberId, practiceAreaId])
  @@map("team_practice_areas")
}

model Faq {
  id             String        @id @default(uuid())
  question       String
  answer         String        @db.Text
  practiceAreaId String?
  practiceArea   PracticeArea? @relation(fields: [practiceAreaId], references: [id], onDelete: SetNull)
  sortOrder      Int           @default(0)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())

  @@map("faqs")
}

model NewsCategory {
  id        String        @id @default(uuid())
  name      String
  slug      String        @unique
  createdAt DateTime      @default(now())

  articles  NewsArticle[]

  @@map("news_categories")
}

model NewsArticle {
  id            String        @id @default(uuid())
  categoryId    String?
  category      NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId      String?
  author        TeamMember?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title         String
  slug          String        @unique
  featuredImage String?
  excerpt       String?
  body          String        @db.Text
  status        PostStatus    @default(DRAFT)
  publishedAt   DateTime?
  metaTitle     String?
  metaDesc      String?
  views         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("news_articles")
}

model ClientLogo {
  id          String   @id @default(uuid())
  companyName String
  logoUrl     String
  websiteUrl  String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("client_logos")
}

model Resource {
  id            String   @id @default(uuid())
  title         String
  description   String?
  fileUrl       String
  category      String?
  downloadCount Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@map("resources")
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  fullName     String?
  email        String   @unique
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model ContactSubmission {
  id          String   @id @default(uuid())
  fullName    String
  email       String
  phone       String?
  subject     String?
  message     String   @db.Text
  isRead      Boolean  @default(false)
  submittedAt DateTime @default(now())

  @@map("contact_submissions")
}

model Settings {
  id           String   @id @default(uuid())
  firmName     String
  tagline      String?
  logoUrl      String?
  faviconUrl   String?
  email        String?
  phone        String?
  facebookUrl  String?
  twitterUrl   String?
  linkedinUrl  String?
  instagramUrl String?
  youtubeUrl   String?
  officeHours  String?
  updatedAt    DateTime @updatedAt

  @@map("settings")
}

model Document {
  id          String         @id @default(uuid())
  name        String
  fileUrl     String
  fileType    String
  fileSize    Int
  category    DocumentCategory
  uploadedBy  String
  uploader    User           @relation(fields: [uploadedBy], references: [id])
  caseId      String?
  case        Case?          @relation(fields: [caseId], references: [id])
  isPublic    Boolean        @default(false)
  isTemplate  Boolean        @default(false)
  createdAt   DateTime       @default(now())

  @@map("documents")
}

model Message {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation(fields: [senderId], references: [id])
  recipientId String?
  subject     String
  content     String
  isRead      Boolean  @default(false)
  isUrgent    Boolean  @default(false)
  parentId    String?
  createdAt   DateTime @default(now())

  @@map("messages")
}

model Payment {
  id            String        @id @default(uuid())
  clientId      String
  client        User          @relation(fields: [clientId], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  description   String
  status        PaymentStatus @default(PENDING)
  stripeId      String?
  invoiceUrl    String?
  paidAt        DateTime?
  dueDate       DateTime?
  createdAt     DateTime      @default(now())

  @@map("payments")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@map("notifications")
}

model IntakeForm {
  id          String   @id @default(uuid())
  name        String
  description String?
  fields      Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  submissions IntakeSubmission[]

  @@map("intake_forms")
}

model IntakeSubmission {
  id            String     @id @default(uuid())
  formId        String
  form          IntakeForm @relation(fields: [formId], references: [id])
  data          Json
  clientEmail   String
  clientName    String
  clientPhone   String?
  appointmentId String?
  createdAt     DateTime   @default(now())

  @@map("intake_submissions")
}

model SiteSettings {
  id              String   @id @default(uuid())
  key             String   @unique
  value           Json
  updatedAt       DateTime @updatedAt

  @@map("site_settings")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

enum Role {
  CLIENT
  ADMIN
  ATTORNEY
}

enum AppointmentType {
  CONSULTATION
  FOLLOW_UP
  CASE_REVIEW
  DEPOSITION
  MEDIATION
  HEARING_PREP
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CaseStatus {
  ACTIVE
  PENDING
  CLOSED
  SETTLED
  WON
  LOST
  ON_HOLD
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DocumentCategory {
  CONTRACT
  CORRESPONDENCE
  COURT_FILING
  EVIDENCE
  INTAKE
  INVOICE
  LEGAL_OPINION
  SETTLEMENT
  TEMPLATE
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  REFUNDED
  CANCELLED
}

enum NotificationType {
  APPOINTMENT
  MESSAGE
  DOCUMENT
  PAYMENT
  CASE_UPDATE
  SYSTEM
}